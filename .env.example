ENV=docker

# Used for docker port mapping and the templ proxy
SERVER_PORT=8080
TEMPL_PROXY_PORT=8081
DATABASE_PORT=5432
REDIS_PORT=6379
JAEGER_UI_PORT=8083

# Goose https://github.com/pressly/goose — for the manual `make db-migrate` cycle
# only; the app runs the same migrations itself at startup.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://goth:STRONG_DB_PASSWORD1@localhost:5432/goth
GOOSE_MIGRATION_DIR=internal/db/migrations
GOOSE_TABLE=tech_goose_db_version
