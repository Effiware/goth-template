{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "This is an example server for a GOTH template application.",
        "title": "GOTH Template API",
        "contact": {
            "name": "EffiSupport",
            "url": "https://www.effiware.com/contact",
            "email": "contact@effiware.com"
