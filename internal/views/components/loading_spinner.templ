package components

// LoadingSpinner pairs with hx-indicator; htmx toggles .htmx-request on the
// indicator element, and the .htmx-indicator class hides it at rest.
templ LoadingSpinner() {
	<div class="w-24 h-1 bg-gray-200 dark:bg-gray-700 rounded overflow-hidden">
		<div class="h-full w-1/3 bg-blue-600 dark:bg-blue-500 rounded animate-[loading_1s_ease-in-out_infinite]"></div>
	</div>
	<style>
		@keyframes loading { 0% { transform: translateX(-100%); } 100% { transform: translateX(400%); } }
	</style>
}
