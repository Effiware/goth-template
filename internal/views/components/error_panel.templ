package components

// ErrorPanel is the fragment hda.WithHTMLFallback swaps in on a failed request.
templ ErrorPanel(message string) {
	<div class="flex items-center gap-2 px-4 py-3 text-sm rounded-lg text-red-700 bg-red-50 border border-red-200 dark:text-red-200 dark:bg-red-900/20 dark:border-red-900/40">
		<svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
		</svg>
		if message != "" {
			{ message }
		} else {
			Something went wrong. Please try again.
		}
	</div>
}
